# ==========================================
# CONFIGURACIÓN DE ENTORNO — MUROTECH SaaS
# ==========================================
# 1. Copia este archivo como .env
#    cp .env.example .env          (Mac/Linux)
#    copy .env.example .env        (Windows)
#
# 2. Completa los valores marcados con TU_***
#
# Si NO configuras Supabase, el sistema usa SQLite automáticamente
# (ideal para probar localmente sin configuración extra).

# ── Base de datos (Supabase — opcional para local) ──────────
# Opción A: URL completa de conexión
# DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Opción B: Componentes individuales
# SUPABASE_HOST=aws-1-us-east-1.pooler.supabase.com
# SUPABASE_PORT=5432
# SUPABASE_DB=postgres
# SUPABASE_USER=postgres.TU_PROYECTO
# SUPABASE_PASS=TU_PASSWORD_AQUI

# ── Seguridad (OBLIGATORIO) ──────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TU_SECRET_KEY_AQUI

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=TU_ENCRYPTION_KEY_AQUI

# ── Servidor ─────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5001
HOST=0.0.0.0

# ── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_AUDIENCE=murotech-api
JWT_ISSUER=murotech
JWT_EXPIRY=3600
JWT_LEEWAY=30

# ── CORS ─────────────────────────────────────────────────────
# Flask sirve frontend + API en el mismo puerto (5001)
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# ── Rate Limiting ────────────────────────────────────────────
RATELIMIT_LOGIN=20 per hour
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=300 per day;60 per hour

# ── CSRF ─────────────────────────────────────────────────────
CSRF_SECRET=TU_CSRF_SECRET_AQUI

# ── Hacienda API (Costa Rica) ────────────────────────────────
# Ambiente de prueba (stag) o producción (prod)
HACIENDA_AMBIENTE=stag
HACIENDA_API_URL=https://api.comprobanteselectronicos.go.cr/recepcion/v1/recepcion
HACIENDA_TOKEN_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/token
HACIENDA_CLIENT_ID=TU_CLIENT_ID
HACIENDA_CLIENT_SECRET=TU_CLIENT_SECRET
HACIENDA_SEND_ENABLED=false
HACIENDA_XSD_VALIDATE=true
HACIENDA_XSD_AUTO_DOWNLOAD=true
HACIENDA_COMPROBANTES_URL=https://api.comprobanteselectronicos.go.cr/recepcion/v1/comprobantes

# ── Redis (OPCIONAL — para rate limiting persistente) ────────
# REDIS_URL=redis://localhost:6379/0

# ── Email (OPCIONAL) ────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=tu_password_app
# SMTP_FROM=noreply@murotech.com

# ── PayPal (OPCIONAL) ──────────────────────────────────────
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ── Stripe (OPCIONAL) ───────────────────────────────────────
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Sentry (OPCIONAL — monitoreo de errores) ─────────────────
# SENTRY_DSN=https://tu_sentry_dsn@sentry.io/proyecto

# ── SQLALCHEMY Pooling (solo producción) ──────────────────────
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
# SQLALCHEMY_POOL_TIMEOUT=30

# ── Backups (OPCIONAL) ──────────────────────────────────────
# BACKUP_ENABLED=True
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# ── reCAPTCHA (OPCIONAL) ─────────────────────────────────────
# RECAPTCHA_SECRET_KEY=
