# ==========================================
# .gitignore — MUROTECH SaaS
# ==========================================

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── IDEs ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Logs ───────────────────────────────────
*.log
logs/

# ── Base de datos local ────────────────────
*.db
*.sqlite3
*.mdf
*.ldf
*.bak
instance/

# ── Configuración sensible ─────────────────
.env
.env.local
.env.production
backend/config/local.py

# ── Certificados ───────────────────────────
*.p12
*.pfx
*.key
*.pem

# ── Archivos temporales ────────────────────
tmp/
temp/
*.tmp
scratch/

# ── Node modules ───────────────────────────
node_modules/

# ── Archivos de sistema ────────────────────
Thumbs.db
desktop.ini

# ── Codely CLI ─────────────────────────────
.codely/
.codely-cli/

# ── Migraciones (se regeneran) ────────────
# Descomenta si prefieres no versionar migraciones:
# backend/migrations/

# ── Coverage / tests ───────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
